DATABASE_URL=postgres://user:password@host:5432/quickcart

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Signs both access tokens issued at login. Generate with `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

WEB_APP_URL=http://localhost:3001
PORT=4000

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Firebase Cloud Messaging legacy server key, for mobile push notifications.
# See src/lib/push.ts for why this is the legacy (not v1) API and when to migrate.
FCM_SERVER_KEY=

# Optional. If set, rate limiting uses a shared Redis store instead of
# per-process memory — only matters once you run more than one instance.
REDIS_URL=

# Used once, to bootstrap the very first organization + owner account.
# See POST /api/v1/organizations/bootstrap in README — protect or remove
# this endpoint after initial setup in a real deployment.
BOOTSTRAP_SECRET=change-me-then-rotate-me

# SMTP, for password-reset and email-verification emails. Any provider
# works (Postmark, SES SMTP, SendGrid SMTP, even Gmail app password for
# testing). Left unset, emails are skipped with a warning rather than
# crashing anything — see src/lib/email.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QuickCart <no-reply@quickcart.ng>

# S3 (or S3-compatible: Cloudflare R2, DigitalOcean Spaces, MinIO) for
# product image uploads. Left unset, POST /uploads/presign returns a clear
# 501 instead of a confusing crash — see src/lib/s3.ts.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Flutterwave — fallback payment provider (or primary, if
# PAYMENT_PRIMARY_PROVIDER=flutterwave). Leave unset to run Paystack-only.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
PAYMENT_PRIMARY_PROVIDER=paystack

# Ops alerting for webhook processing failures. Either or both.
OPS_ALERT_EMAIL=
SLACK_ALERT_WEBHOOK_URL=

# Optional. If set, secrets are loaded from AWS Secrets Manager at startup
# and merged into process.env (only filling in currently-unset vars — see
# lib/secrets.ts). Requires AWS credentials available to the process
# (IAM role in production; AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above
# for local testing).
SECRETS_MANAGER_ARN=
AWS_REGION=us-east-1

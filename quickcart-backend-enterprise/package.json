{
  "name": "quickcart-backend-enterprise",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "db:migrate": "node -e \"require('dotenv').config(); const fs=require('fs'); const {Pool}=require('pg'); const pool=new Pool({connectionString:process.env.DATABASE_URL}); pool.query(fs.readFileSync('./schema.sql','utf8')).then(()=>{console.log('migrated');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "express": "4.19.2",
    "cors": "2.8.5",
    "pg": "8.12.0",
    "dotenv": "16.4.5",
    "jsonwebtoken": "9.0.2",
    "helmet": "7.1.0",
    "bcryptjs": "2.4.3",
    "zod": "3.23.8",
    "express-rate-limit": "7.4.0",
    "pino": "9.3.2",
    "pino-http": "10.2.0",
    "ioredis": "5.4.1",
    "rate-limit-redis": "4.2.0",
    "nodemailer": "6.9.14",
    "@aws-sdk/client-s3": "3.1083.0",
    "@aws-sdk/s3-request-presigner": "3.1083.0",
    "@aws-sdk/client-secrets-manager": "3.1083.0",
    "swagger-ui-express": "5.0.1",
    "yamljs": "0.3.0",
    "otplib": "12.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "ts-node-dev": "2.0.0",
    "@types/express": "4.17.21",
    "@types/cors": "2.8.17",
    "@types/node": "20.14.13",
    "@types/pg": "8.11.6",
    "@types/jsonwebtoken": "9.0.6",
    "@types/bcryptjs": "2.4.6",
    "@types/nodemailer": "6.4.15",
    "@types/swagger-ui-express": "4.1.6",
    "@types/yamljs": "0.2.34",
    "@types/qrcode": "1.5.5",
    "jest": "29.7.0",
    "ts-jest": "29.2.4",
    "@types/jest": "29.5.12",
    "supertest": "7.0.0",
    "@types/supertest": "6.0.2"
  }
}
